{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Manejo</p>
    <h1 class="h3 fw-bold mb-2"><i class="bi bi-signpost-split text-primary me-2"></i>Alocações</h1>
    <p class="text-secondary mb-0">Consulte as alocações cadastradas no sistema.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Lista de alocações</h2>
          <p class="text-secondary mb-0">Alocações retornadas pelo servidor backend.</p>
        </div>
        <a class="btn btn-primary" href="/alocados/form?oper=Cr" id="btnNovoAlocado">Incluir nova alocação</a>
      </div>

      <div id="alocadosAlert" class="alert alert-danger d-none" role="alert"></div>

      <div id="alocadosListagem" data-servidor-dw3="{{ servidorDw3 }}">
        <div class="table-responsive">
          <table id="tblAlocados" class="table table-striped table-hover align-middle w-100">
            <thead>
              <tr>
                <th>ID</th>
                <th>Animal</th>
                <th>Piquete</th>
                <th>Data de início</th>
                <th>Data final</th>
                <th>Operações</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script>
  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/alocados/vwLstAlocados.js"></script>
{% endblock %}

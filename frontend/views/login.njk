{% extends "layout.njk" %}

{% block content %}
  <section class="login-tela d-flex align-items-center justify-content-center">
    <div class="login-painel card">
      <div class="row g-0">
        <div class="col-md-6 login-ilustracao">
          <p class="page-kicker fw-semibold mb-2">Módulo Agrícola</p>
          <h1 class="fw-bold mb-3">Pastejo Rotacionado</h1>
          <p class="mb-0">Pastos divididos em piquetes, animais em rodízio e o capim sempre descansado.</p>
        </div>

        <div class="col-md-6 p-4 p-md-5">
          <h2 class="h4 fw-bold mb-1">Entrar</h2>
          <p class="text-secondary mb-4">Informe seu usuário e senha para continuar.</p>

          <form id="loginForm" data-servidor-dw3="{{ servidorDw3 }}">
            <div id="loginError" class="alert alert-danger d-none" role="alert"></div>
            <div class="mb-3">
              <label class="form-label" for="usuario">Usuário</label>
              <input class="form-control" id="usuario" name="usuario" type="text" placeholder="Seu usuário" autocomplete="username">
            </div>
            <div class="mb-4">
              <label class="form-label" for="senha">Senha</label>
              <input class="form-control" id="senha" name="senha" type="password" placeholder="Sua senha" autocomplete="current-password">
            </div>
            <button class="btn btn-primary w-100" type="submit">Entrar</button>
          </form>
        </div>
      </div>
    </div>
  </section>
  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/login/vwLogin.js"></script>
{% endblock %}

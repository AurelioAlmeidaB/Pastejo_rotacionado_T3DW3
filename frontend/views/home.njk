{% extends "layout.njk" %}

{% block content %}
  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Módulo agrícola</p>
    <h1 class="display-6 fw-bold mb-2">Painel principal</h1>
    <p class="text-secondary mb-0">Use a navegação superior para acessar pastos, piquetes, animais, alocações ou sair da aplicação.</p>
  </header>

  <div class="hero-card card border-0 shadow-sm">
    <div class="card-body p-4 p-lg-5">
      <div class="row g-4 align-items-center">
        <div class="col-lg-8">
          <h2 class="h4 fw-semibold mb-3">Bem-vindo ao sistema</h2>
          <p class="text-secondary mb-0">Cadastre os pastos e seus piquetes, os animais e controle em qual piquete cada animal está alocado.</p>
        </div>
        <div class="col-lg-4 d-flex flex-column gap-2">
          <a class="btn btn-primary" href="/alocados">Ir para alocações</a>
          <a class="btn btn-outline-primary" href="/pastos">Ir para pastos</a>
          <a class="btn btn-outline-primary" href="/piquetes">Ir para piquetes</a>
          <a class="btn btn-outline-primary" href="/animais">Ir para animais</a>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/home/vwHome.js"></script>
{% endblock %}

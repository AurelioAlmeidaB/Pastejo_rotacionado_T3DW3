<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or 'Pastejo Rotacionado' }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Nunito:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="app-shell">
  {% if showNavbar %}
    <nav class="navbar navbar-expand-md navbar-light app-navbar">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/home"><span class="marca-icone"><i class="bi bi-tree-fill"></i></span>Pastejo Rotacionado</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
          data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegação">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto mb-2 mb-md-0 gap-md-2">
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'home' %}active{% endif %}" href="/home"><i class="ico ico-celeiro me-1"></i>Início</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'pastos' %}active{% endif %}" href="/pastos"><i class="ico ico-capim me-1"></i>Pastos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'piquetes' %}active{% endif %}" href="/piquetes"><i class="ico ico-piquete me-1"></i>Piquetes</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'animais' %}active{% endif %}" href="/animais"><i class="ico ico-vaca me-1"></i>Animais</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'alocados' %}active{% endif %}" href="/alocados"><i class="bi bi-signpost-split me-1"></i>Alocações</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/login"><i class="ico ico-porteira me-1"></i>Sair</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  {% endif %}

  <main class="app-main">
    <div class="container py-4 py-lg-5">
      {% block content %}{% endblock %}
    </div>
  </main>

  {% if showNavbar %}
    <footer class="app-footer text-center">
      Pastejo Rotacionado · DW3 · IFSP Votuporanga
    </footer>
  {% endif %}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
